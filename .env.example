# Copy to `.env.local` (gitignored). Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox (client token; restrict by URL in Mapbox dashboard) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Google Gemini (server only) ---
GEMINI_API_KEY=
# Optional. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- AgroMonitoring (server only) ---
AGROMONITORING_API_KEY=
