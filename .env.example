# Copy this file to .env (it is gitignored) and fill in the key. Never commit .env.

# SERVER ONLY. Used by /api (Vercel functions). Never add an EXPO_PUBLIC_ prefix: that would ship the key to every phone.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. A Gemini model with vision. Default: gemini-flash-latest (always the current Flash). Pin one, e.g. gemini-3.8-flash
GEMINI_MODEL=

# PUBLIC (safe in the app): where the app finds /api when it is not on the same site, e.g. in local development.
# Leave empty on Vercel. For `npm run api` use http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
