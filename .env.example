# Copy to `.env.local` (gitignored). Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox (client token; restrict by URL in Mapbox dashboard) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Google Vertex AI (server only; fruit / trap / label / advise) ---
# Service account JSON lives at project root (gitignored): gcp-service-account.json
GOOGLE_CLOUD_PROJECT=agropulse-vertex
# Gemini 3.x on agropulse-vertex requires the global Vertex host (us-central1 returns 404)
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
# On Vercel (no files): paste the whole key JSON on one line. It wins over the file; 
 in the private key is fine.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Model id on Vertex — no "models/" prefix (fallback: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash
# Do NOT set GEMINI_API_KEY when using Vertex (it can override the client)
# GEMINI_API_KEY=

# --- Hugging Face leaf model (server only) ---
# Space that runs research TFLite leaf classifier (legacy 03_hf_space).
# REQUIRED for reliable leaf scans: ZeroGPU anonymous quota is tiny.
# Create a free read token: https://huggingface.co/settings/tokens
LEAF_HF_SPACE=hupus/agropulse-leaf
HF_TOKEN=

# --- AgroMonitoring (server only) ---
AGROMONITORING_API_KEY=

# --- Processor signup (C7) ---
